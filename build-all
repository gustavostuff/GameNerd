#!/usr/bin/env bash
# Build Studio, Emu, Sim, Nano Studio, Nano Emu, and Nano Sim (Release) into bin/.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
BIN="$ROOT/bin"
STUDIO="$ROOT/app/studio"
EMU="$ROOT/app/emu"
SIM="$ROOT/app/sim"
NANO_STUDIO="$ROOT/nano/apps/studio"
NANO_EMU="$ROOT/nano/apps/emu"
NANO_SIM="$ROOT/nano/apps/sim"

build_one() {
  local proj="$1"
  local target="$2"
  local out_name="$3"
  # Folder moves leave CMakeCache pointing at the old source path.
  if [ -f "$proj/build/CMakeCache.txt" ] &&
     ! grep -q "CMAKE_HOME_DIRECTORY:INTERNAL=$proj$" "$proj/build/CMakeCache.txt"; then
    echo "stale CMake cache in $proj/build -- removing"
    rm -rf "$proj/build"
  fi
  cmake -S "$proj" -B "$proj/build" -DCMAKE_BUILD_TYPE=Release
  cmake --build "$proj/build" --target "$target" -j"$(nproc)"
  install -Dm755 "$proj/build/$target" "$BIN/$out_name"
}

mkdir -p "$BIN"

echo "== studio =="
build_one "$STUDIO" retr01_studio studio

echo "== emu =="
build_one "$EMU" retr01_emu emu

echo "== sim =="
build_one "$SIM" retr01_sim sim

echo "== nano_studio =="
build_one "$NANO_STUDIO" retr01_nano_studio nano_studio

echo "== nano_emu =="
build_one "$NANO_EMU" retr01_nano_emu nano_emu

echo "== nano_sim =="
build_one "$NANO_SIM" retr01_nano_sim nano_sim

echo "binaries:"
ls -lh "$BIN"/studio "$BIN"/emu "$BIN"/sim "$BIN"/nano_studio "$BIN"/nano_emu "$BIN"/nano_sim
