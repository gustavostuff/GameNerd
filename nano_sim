#!/usr/bin/env bash
# Run the Release Nano Sim binary from bin/ (build with ./build-all first).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
BIN="$ROOT/bin/nano_sim"
CART="${1:-$ROOT/output/nano/test.r01nano}"
shift || true

die() { echo "error: $*" >&2; exit 1; }

[[ -x "$BIN" ]] || die "missing $BIN -- run ./build-all first"

if [[ "$CART" != /* ]]; then
  if [[ -f "$ROOT/$CART" ]]; then
    CART="$ROOT/$CART"
  elif [[ -f "$CART" ]]; then
    CART="$(cd "$(dirname "$CART")" && pwd)/$(basename "$CART")"
  else
    CART="$ROOT/$CART"
  fi
fi
[[ -f "$CART" ]] || die "cart not found: $CART"

exec "$BIN" "$CART" "$@"
